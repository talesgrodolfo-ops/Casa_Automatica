spring.application.name=LightHouse

spring.datasource.url=jdbc:mysql://localhost:3306/LightHouse
spring.datasource.username=root
spring.datasource.password=CHANGE_ME

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
server.port=8000

springdoc.swagger-ui.path=/swagger-ui.html
springdoc.api-docs.enabled=true
springdoc.swagger-ui.enabled=true

# Mínimo: senha com 12+ caracteres; chave do ESP32 com 32+ caracteres
lighthouse.security.user.name=admin
lighthouse.security.user.password=CHANGE_ME_MIN_12_CHARS
lighthouse.security.device-api-key=CHANGE_ME_DEVICE_KEY_MIN_32_CHARACTERS_LONG
lighthouse.security.rate-limit.requests-per-minute=120
